---
interface Props {
  lang: "zh-CN" | "en";
  pageUrl: URL;
  alternateUrl: URL;
  title: string;
  description: string;
}

import "../css/content-page.css";
import InnerPageHeader from "../components/InnerPageHeader.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { latestRelease } from "../data/release";

const { lang, pageUrl, alternateUrl, title, description } = Astro.props;
const en = lang === "en";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const homeUrl = new URL("", siteBase).pathname;
const isCasesPage = pageUrl.pathname.includes("/cases/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead lang={lang} pageUrl={pageUrl} alternateUrl={alternateUrl} title={title} description={description} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="content-page-skip" href="#content-page-main">{en ? "Skip to content" : "跳转到正文"}</a>
    <InnerPageHeader lang={lang} pageUrl={pageUrl} alternateUrl={alternateUrl} />
    <main id="content-page-main">
      <slot />
    </main>
    <section class="content-page-cta shell" aria-labelledby="content-page-cta-title">
      <div>
        <p class="kicker">{en ? (isCasesPage ? "NEXT, VERIFY" : "CHOOSE A TARGET") : (isCasesPage ? "下一步，验证" : "选定一个目标")}</p>
        <h2 id="content-page-cta-title">
          {en
            ? (isCasesPage ? <>Found a path?<br /><em>Make it part of your work.</em></> : <>Choose a target.<br /><em>Keep the evidence close.</em></>)
            : (isCasesPage ? <>找到一条路径？<br /><em>带回你的工作流。</em></> : <>选定一个目标。<br /><em>把证据留在手边。</em></>)}
        </h2>
        <p>
          {en
            ? (isCasesPage ? <>Review the fixture and test evidence, then choose a package from the <strong>{latestRelease.tag}</strong> release page.</> : <>Choose a target, then pick a package from the <strong>{latestRelease.tag}</strong> release page, or return home for the full workflow.</>)
            : (isCasesPage ? <>复核测试样本与测试证据后，前往 <strong>{latestRelease.tag}</strong> 版本发布页选择安装包。</> : <>选定目标后，前往 <strong>{latestRelease.tag}</strong> 版本发布页选择安装包，或回到首页了解完整工作流。</>)}
        </p>
      </div>
      <div class="content-page-cta-actions">
        <a class="button button-light" data-release-link href={latestRelease.url} target="_blank" rel="noreferrer">
          {en ? `View stable downloads for ${latestRelease.tag}` : `查看 ${latestRelease.tag} 稳定版下载`} <span>↗</span>
        </a>
        <a class="text-link text-link-internal" href={homeUrl}>{en ? "Back to the homepage" : "回到首页"} <span>→</span></a>
      </div>
    </section>
    <SiteFooter lang={lang} />
    <script>
      import "../js/app";
    </script>
  </body>
</html>
