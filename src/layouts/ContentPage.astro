---
interface Props {
  lang: "zh-CN" | "en";
  pageUrl: URL;
  alternateUrl: URL;
  title: string;
  description: string;
}

import "../css/content-page.css";
import SeoHead from "../components/SeoHead.astro";
import { latestRelease } from "../data/release";

const { lang, pageUrl, alternateUrl, title, description } = Astro.props;
const en = lang === "en";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const homeUrl = siteBase.href;
const formatsUrl = new URL(en ? "en/formats/" : "formats/", siteBase).href;
const casesUrl = new URL(en ? "en/cases/" : "cases/", siteBase).href;
const labUrl = new URL(en ? "en/lab/" : "lab/", siteBase).href;
const iconUrl = new URL("assets/icons/easyki-icon.svg", siteBase).href;
const isCurrent = (href: string) => new URL(href).pathname === pageUrl.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead lang={lang} pageUrl={pageUrl} alternateUrl={alternateUrl} title={title} description={description} />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="content-page-skip" href="#content-page-main">{en ? "Skip to content" : "跳转到正文"}</a>
    <header class="site-header content-page-header shell">
      <a class="brand" href={homeUrl} aria-label={en ? "EasyKiConverter home" : "EasyKiConverter 首页"}>
        <img src={iconUrl} alt="" width="36" height="36" />
        <span>EasyKiConverter</span>
      </a>
      <nav class="nav-links" aria-label={en ? "Page navigation" : "页面导航"}>
        <a href={homeUrl}>{en ? "Home" : "首页"}</a>
        <a href={formatsUrl} aria-current={isCurrent(formatsUrl) ? "page" : undefined}>{en ? "Formats" : "格式矩阵"}</a>
        <a href={casesUrl} aria-current={isCurrent(casesUrl) ? "page" : undefined}>{en ? "Cases" : "转换案例"}</a>
        <a href={labUrl} aria-current={isCurrent(labUrl) ? "page" : undefined}>{en ? "3D Lab" : "3D 实验室"}</a>
        <a href={alternateUrl}>{en ? "中文" : "English"}</a>
      </nav>
      <div class="header-actions">
        <a class="github-link" href="https://github.com/EasyKiconverter/EasyKiConverter" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">{en ? "Menu" : "菜单"}</button>
      </div>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label={en ? "Mobile page navigation" : "移动端页面导航"}>
      <a href={homeUrl}>{en ? "Home" : "首页"}</a>
      <a href={formatsUrl} aria-current={isCurrent(formatsUrl) ? "page" : undefined}>{en ? "Formats" : "格式矩阵"}</a>
      <a href={casesUrl} aria-current={isCurrent(casesUrl) ? "page" : undefined}>{en ? "Cases" : "转换案例"}</a>
      <a href={labUrl} aria-current={isCurrent(labUrl) ? "page" : undefined}>{en ? "3D Lab" : "3D 实验室"}</a>
      <a href={alternateUrl}>{en ? "中文" : "English"}</a>
      <a href="https://github.com/EasyKiconverter/EasyKiConverter" target="_blank" rel="noreferrer">GitHub ↗</a>
    </nav>
    <main id="content-page-main">
      <slot />
    </main>
    <section class="content-page-cta shell" aria-labelledby="content-page-cta-title">
      <div>
        <p class="kicker">{en ? "READY TO USE" : "准备开始"}</p>
        <h2 id="content-page-cta-title">
          {en ? <>Bring the next part<br /><em>back to your work.</em></> : <>把下一块元件<br /><em>带回你的工作流。</em></>}
        </h2>
        <p>
          {en
            ? <>Download the current stable release <strong>{latestRelease.tag}</strong>, or return to the homepage for the full workflow.</>
            : <>下载当前稳定版 <strong>{latestRelease.tag}</strong>，或回到首页了解完整工作流。</>}
        </p>
      </div>
      <div class="content-page-cta-actions">
        <a class="button button-dark" data-release-link href={latestRelease.url} target="_blank" rel="noreferrer">
          {en ? "Download stable" : "下载稳定版"} <span>↗</span>
        </a>
        <a class="text-link" href={homeUrl}>{en ? "Back to the homepage" : "回到首页"} <span>→</span></a>
      </div>
    </section>
    <footer class="site-footer shell">
      <p>© EasyKiConverter · GPL-3.0</p>
      <a href={homeUrl}>{en ? "Return home" : "返回首页"}</a>
    </footer>
    <script>
      import "../js/app";
    </script>
  </body>
</html>
