---
import "../../css/styles.css";
import "../../css/accessibility.css";
import "../../css/formats.css";
import ContentPage from "../../layouts/ContentPage.astro";
import FormatMatrix from "../../components/FormatMatrix.astro";

const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("formats/", siteBase);
const englishUrl = new URL("en/formats/", siteBase);
---

<ContentPage
  lang="zh-CN"
  pageUrl={pageUrl}
  alternateUrl={englishUrl}
  title="EasyKiConverter · EDA 格式能力矩阵"
  description="EasyKiConverter 版本化 EDA 格式能力矩阵。"
>
  <FormatMatrix lang="zh" />
</ContentPage>
