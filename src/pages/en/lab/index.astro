---
import "../../../css/styles.css";
import "../../../css/accessibility.css";
import "../../../css/content-page.css";
import "../../../css/motion-narrative.css";
import "../../../css/lab.css";
import InnerPageHeader from "../../../components/InnerPageHeader.astro";
import MotionNarrative from "../../../components/MotionNarrative.astro";
import SeoHead from "../../../components/SeoHead.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { latestRelease } from "../../../data/release";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("en/lab/", siteBase);
const chineseUrl = new URL("lab/", siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang="en"
      pageUrl={pageUrl}
      alternateUrl={chineseUrl}
      title="EasyKiConverter · 3D Technology Lab"
      description="An isolated STEP, mesh and section laboratory that does not affect homepage loading."
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="content-page-skip" href="#lab-main">Skip to lab content</a>
    <InnerPageHeader lang="en" pageUrl={pageUrl} alternateUrl={chineseUrl} />
    <main id="lab-main">
      <section class="lab-intro" aria-labelledby="lab-title">
        <p class="kicker">ON DEMAND · EXPERIMENTAL 3D</p>
        <h1 id="lab-title">Real geometry, isolated experiments.</h1>
        <p>Start with the GLB delivery model generated from real STEP geometry, then switch to the mesh atlas, section tomogram and topology views; experimental controls unlock as model data becomes ready. The homepage stays lightweight; CAD/WASM loads only when this lab is opened.</p>
        <p class="lab-warning">The Lab normally loads about 10.0 MB of desktop GLB or 8.4 MB of mobile GLB; STEP/WASM is used only as a fallback. Use a desktop browser for technical validation; use the stable-release link below for downloads, or return home for product information.</p>
        <ul class="lab-facts" aria-label="Lab loading strategy">
          <li><span>Delivery</span><strong>GLB first</strong></li>
          <li><span>Fallback</span><strong>STEP / WASM</strong></li>
          <li><span>Homepage</span><strong>Isolated</strong></li>
        </ul>
        <div class="lab-intro-actions">
          <a class="button button-light" data-release-link href={latestRelease.url} target="_blank" rel="noreferrer">Download stable {latestRelease.tag} <span>↗</span></a>
          <a class="text-link text-link-internal" href={siteBase.href}>Back to product <span>→</span></a>
          <a class="text-link text-link-internal" href={new URL("en/formats/", siteBase)}>View format matrix <span>→</span></a>
        </div>
      </section>
      <MotionNarrative lang="en" />
    </main>
    <SiteFooter lang="en" />
    <script>
      import "../../../js/app";
    </script>
    <script>
      import { setupModel } from "../../../js/model-viewer";
      setupModel();
    </script>
  </body>
</html>
