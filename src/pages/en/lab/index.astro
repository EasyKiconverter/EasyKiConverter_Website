---
import "../../../css/styles.css";
import "../../../css/accessibility.css";
import "../../../css/content-page.css";
import "../../../css/motion-narrative.css";
import "../../../css/lab.css";
import InnerPageHeader from "../../../components/InnerPageHeader.astro";
import MotionNarrative from "../../../components/MotionNarrative.astro";
import SeoHead from "../../../components/SeoHead.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { latestRelease } from "../../../data/release";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("en/lab/", siteBase);
const chineseUrl = new URL("lab/", siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang="en"
      pageUrl={pageUrl}
      alternateUrl={chineseUrl}
      title="EasyKiConverter · 3D Technology Lab"
      description="Explore real STEP geometry through a GLB, mesh, section, and topology views. CAD/WASM stays off the homepage."
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="content-page-skip" href="#lab-main">Skip to lab content</a>
    <InnerPageHeader lang="en" pageUrl={pageUrl} alternateUrl={chineseUrl} />
    <main id="lab-main">
      <section class="lab-intro" aria-labelledby="lab-title">
        <p class="kicker">ON DEMAND · EXPERIMENTAL 3D</p>
        <h1 id="lab-title">Explore real geometry.</h1>
        <p>Explore real STEP geometry in GLB, mesh, section, and topology views. CAD/WASM stays off the homepage.</p>
        <div class="lab-warning" aria-label="Lab loading guidance">
          <div class="lab-warning-heading"><span>Loading plan</span><strong>GLB first</strong></div>
          <div class="lab-warning-metrics">
            <span><b>10.0 MB</b><small>desktop GLB</small></span>
            <span><b>8.4 MB</b><small>mobile GLB</small></span>
          </div>
          <p>STEP/WASM is used only if the model fails to load. Use a desktop browser for technical validation; use the stable-release link below for downloads, or return home for product information.</p>
        </div>
        <div class="lab-intro-actions">
          <a class="button button-dark" data-release-link href={latestRelease.url} target="_blank" rel="noreferrer">View stable downloads for {latestRelease.tag} <span>↗</span></a>
          <a class="text-link text-link-internal" href={siteBase.href}>Back to product <span>→</span></a>
          <a class="text-link text-link-internal" href={new URL("en/formats/", siteBase).pathname}>View format matrix <span>→</span></a>
        </div>
      </section>
      <MotionNarrative lang="en" />
    </main>
    <SiteFooter lang="en" />
    <script>
      import "../../../js/app";
    </script>
    <script>
      import { setupModel } from "../../../js/model-viewer";
      setupModel();
    </script>
  </body>
</html>
