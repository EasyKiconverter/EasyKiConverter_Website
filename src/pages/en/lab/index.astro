---
import "../../../css/styles.css";
import "../../../css/accessibility.css";
import "../../../css/content-page.css";
import "../../../css/motion-narrative.css";
import "../../../css/lab.css";
import MotionNarrative from "../../../components/MotionNarrative.astro";
import SeoHead from "../../../components/SeoHead.astro";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("en/lab/", siteBase);
const chineseUrl = new URL("lab/", siteBase);
const iconUrl = new URL("assets/icons/easyki-icon.svg", siteBase);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang="en"
      pageUrl={pageUrl}
      alternateUrl={chineseUrl}
      title="EasyKiConverter · 3D Technology Lab"
      description="An isolated STEP, mesh and section laboratory that does not affect homepage loading."
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="content-page-skip" href="#lab-main">Skip to lab content</a>
    <header class="lab-header site-header content-page-header shell">
      <a class="brand" href={siteBase.href} aria-label="Return to EasyKiConverter home"><img src={iconUrl.href} alt="" width="36" height="36" /><span>EasyKiConverter <small>/ Lab</small></span></a>
      <nav class="nav-links" aria-label="Lab navigation"><a href={siteBase.href}>Home</a><a href={new URL("en/formats/", siteBase)}>Formats</a><a href={new URL("en/cases/", siteBase)}>Cases</a><a href={new URL("en/lab/", siteBase)} aria-current="page">3D Lab</a><a href={chineseUrl}>中文</a></nav>
      <a class="github-link" href="https://github.com/EasyKiconverter/EasyKiConverter" target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
    </header>
    <main id="lab-main">
      <section class="lab-intro" aria-labelledby="lab-title">
        <p class="kicker">ON DEMAND · EXPERIMENTAL 3D</p>
        <h1 id="lab-title">Real geometry, isolated experiments.</h1>
        <p>This lab retains the STEP, Three.js, cross-section and topology research work. The homepage stays lightweight; CAD/WASM loads only when this lab is opened.</p>
        <p class="lab-warning">The Lab normally loads about 10.0 MB of desktop GLB or 8.4 MB of mobile GLB; STEP/WASM is used only as a fallback. Use a desktop browser for technical validation; return home for product information and downloads.</p>
        <div class="lab-intro-actions">
          <a class="button button-dark" href={siteBase.href}>Back to product <span>→</span></a>
          <a class="text-link" href={new URL("en/formats/", siteBase)}>View format matrix <span>↗</span></a>
        </div>
      </section>
      <MotionNarrative lang="en" />
    </main>
    <footer class="site-footer shell"><p>© EasyKiConverter · GPL-3.0</p><a href={siteBase.href}>Return home</a></footer>
    <script>
      import { setupModel } from "../../../js/model-viewer";
      setupModel();
    </script>
  </body>
</html>
