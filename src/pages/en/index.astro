---
import "../../css/styles.css";
import "../../css/accessibility.css";
import "../../css/easter-eggs.css";
import "../../css/home-polish.css";
import SeoHead from "../../components/SeoHead.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ProductStage from "../../components/ProductStage.astro";
import ConversionScene from "../../components/ConversionScene.astro";
import PlatformAvailability from "../../components/PlatformAvailability.astro";
import ShowcaseCaption from "../../components/ShowcaseCaption.astro";
import WorkbenchActions from "../../components/WorkbenchActions.astro";
import WorkflowActions from "../../components/WorkflowActions.astro";
import { targetFormats } from "../../data/formats";
import { getPlatformAvailability } from "../../data/platforms";
import { latestRelease } from "../../data/release";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const chineseUrl = siteBase.href;
const englishUrl = new URL("en/", siteBase).href;
const socialImageUrl = new URL(
  "assets/showcase/easykiconverter-main-public.webp",
  siteBase,
).href;
const appImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easykiconverter-main-public.webp`;
const modelImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easyki-real-model-hero.webp`;
const storyModelUrl = `${import.meta.env.BASE_URL}assets/showcase/easyki-conversion-story.glb`;
const exportImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easykiconverter-export.webp`;
const primaryFormats = targetFormats.filter((format) => format.tier === "primary");
const additionalFormatCount = targetFormats.filter((format) => format.tier === "registered").length;
const platformAvailability = getPlatformAvailability("en");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang="en"
      pageUrl={new URL(englishUrl)}
      alternateUrl={new URL(chineseUrl)}
      title="EasyKiConverter · Make parts EDA-ready"
      description="Convert LCSC / EasyEDA data into symbols, footprints, and 3D models for KiCad or Altium. Free, open source, and cross-platform."
      socialImageUrl={new URL(socialImageUrl)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "EasyKiConverter",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows, Linux, macOS",
        softwareVersion: latestRelease.version,
        license: "https://www.gnu.org/licenses/gpl-3.0.html",
        downloadUrl:
          "https://github.com/EasyKiconverter/EasyKiConverter/releases",
        url: englishUrl,
        codeRepository: "https://github.com/EasyKiconverter/EasyKiConverter",
        description:
          "Convert LCSC and EasyEDA component data into practical KiCad and Altium libraries with GUI and CLI workflows.",
      })}
    ></script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#top">Skip to content</a>
    <SiteHeader lang="en" variant="home" homeHref="#top" alternateUrl={new URL(chineseUrl)} />
    <main id="top" tabindex="-1">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="kicker">OPEN SOURCE · <span class="kicker-brand-case">Qt</span> 6 DESKTOP TOOL</p>
          <h1 id="hero-title">
            Make parts{" "}
            <br />
            <em>EDA-ready.</em>
          </h1>
          <p class="hero-lede">
            LCSC / EasyEDA parts → symbols, footprints &amp; 3D models for KiCad / Altium.
          </p>
          <div class="hero-actions">
            <a
              class="button button-dark magnetic"
              data-release-link
              href={latestRelease.url}
              target="_blank"
              rel="noreferrer"
            >
              {latestRelease.tag} downloads <span>↗</span>
            </a>
            <a class="text-link text-link-down" href="#story">
              See how it works <span>↓</span>
            </a>
          </div>
          <div class="hero-facts">
            <span>
              <b data-release-version>{latestRelease.tag}</b> current stable
            </span>
            <span>
              <b>GPL-3.0</b> open source
            </span>
            <span>
              <b>GUI + CLI</b> two ways in
            </span>
          </div>
        </div>
        <ProductStage lang="en" appImageUrl={appImageUrl} modelImageUrl={modelImageUrl} />
        <a class="scroll-cue" href="#story" aria-label="Continue downward">
          Continue <span></span>
        </a>
      </section>
      <div class="marquee" aria-hidden="true">
        <div>
          <span>SYMBOL</span>
          <i>✳</i>
          <span>FOOTPRINT</span>
          <i>✳</i>
          <span>EDA LIBRARY</span>
          <i>✳</i>
          <span>BOM</span>
          <i>✳</i>
          <span>GUI + CLI</span>
          <i>✳</i>
          <span>SYMBOL</span>
          <i>✳</i>
          <span>FOOTPRINT</span>
          <i>✳</i>
        </div>
      </div>
      <section
        id="story"
        class="story section shell"
        aria-labelledby="story-title"
      >
        <div id="workflow" class="section-intro workflow-copy reveal">
          <p class="kicker">ONE PATH, THREE STAGES</p>
          <h2 id="story-title">
            Component data,{" "}
            <br />
            <em>ready for your EDA.</em>
          </h2>
          <p>
            Enter an LCSC number or BOM, prepare symbols, footprints and 3D models, then bring the target library into KiCad, Altium or your existing design workflow.
          </p>
          <WorkflowActions lang="en" />
        </div>
        <div class="story-rail" data-story-rail>
          <ConversionScene lang="en" modelImageUrl={modelImageUrl} modelUrl={storyModelUrl} />
          <article class="story-card story-card-a reveal">
            <span class="story-index">01 / INPUT</span>
            <h3>
              Bring the{" "}
              <br />
              part in.
            </h3>
            <p>
              Paste an LCSC number or import a BOM. Clipboard extraction keeps
              the small work small.
            </p>
            <a class="story-link" href="cases/">Read a real case <span>→</span></a>
            <div class="story-pulse">
              C2040 <span>→</span>
            </div>
          </article>
          <article class="story-card story-card-b reveal reveal-delay-1">
            <span class="story-index">02 / SHAPE</span>
            <h3>
              Symbol, footprint{" "}
              <br />
              and model together.
            </h3>
            <p>
              Fetch data, map layers and process 3D files while batch work stays
              multi-threaded.
            </p>
            <a class="story-link" href="lab/">Open 3D Lab <span>→</span></a>
            <div class="story-stack">
              <b>SYMBOL</b>
              <b>FOOTPRINT</b>
              <b>3D MODEL</b>
            </div>
          </article>
          <article class="story-card story-card-c reveal reveal-delay-2">
            <span class="story-index">03 / DELIVER</span>
            <h3>
              Take it into{" "}
              <br />
              your target EDA.
            </h3>
            <p>
              Generate the target library, review the conversion result, and continue designing in your EDA.
            </p>
            <a class="story-link" href="formats/">Check format support <span>→</span></a>
            <div class="story-check">✓ library generated</div>
          </article>
        </div>
      </section>
      <section
        class="product-showcase section shell"
        aria-labelledby="showcase-title"
      >
        <div class="section-intro section-intro-wide reveal">
          <p class="kicker">THE REAL WORKBENCH</p>
          <h2 id="showcase-title">
            This is not a concept image.{" "}
            <br />
            <em>It is the actual workbench.</em>
          </h2>
          <p>
            The opening view shows component entry and BOM import. Here, the real export
            settings, processing progress and component results complete the story from setup to delivery.
          </p>
        </div>
        <figure class="app-window reveal">
          <div class="window-chrome">
            <span class="window-icon">
              <img src="../assets/icons/easyki-icon.svg" alt="" />
            </span>
            <b>EasyKiConverter</b>
            <span class="window-spacer"></span>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <img
            src={exportImageUrl}
            alt="The actual EasyKiConverter Qt Quick export view showing export settings, processing progress and component results; local output path hidden"
            loading="lazy"
          />
          <ShowcaseCaption lang="en" imageUrl={exportImageUrl} />
        </figure>
        <WorkbenchActions lang="en" />
      </section>
      <section
        id="features"
        class="features section shell"
        aria-labelledby="features-title"
      >
        <div class="section-heading reveal">
          <div>
            <p class="kicker">A TOOL WITH GOOD MANNERS</p>
            <h2 id="features-title">
              Make the tedious parts{" "}
              <br />
              <em>a little easier.</em>
            </h2>
          </div>
          <p>
            Every feature is grounded in a real electronics workflow: it does
            not pretend to design for you, it simply removes mechanical work.
          </p>
        </div>
        <div class="feature-grid">
          <article id="formats" class="feature-card feature-card-large reveal">
            <span class="feature-number">01</span>
            <div>
              <h3>Multiple targets</h3>
              <p>
                The current stable release focuses on KiCad and Altium. For other
                targets, use the matching Release and format matrix to confirm
                current support.
              </p>
              <div class="format-pills" data-format-summary>
                {primaryFormats.map((format) => <b>{format.name}</b>)}
                <b>+ {additionalFormatCount} additional targets</b>
              </div>
              <div class="feature-links" aria-label="Format and case-study entries">
                <a class="feature-link feature-link-internal feature-link-primary" href="formats/">View format matrix <span>→</span></a>
                <a class="feature-link feature-link-internal feature-link-secondary" href="cases/">View conversion cases <span>→</span></a>
              </div>
            </div>
          </article>
          <article class="feature-card feature-card-mint reveal reveal-delay-1">
            <span class="feature-symbol">⌁</span>
            <h3>Batch, quietly</h3>
            <p>
              BOM import, multi-threading and remembered settings keep large
              jobs calm.
            </p>
          </article>
          <article class="feature-card feature-card-peach reveal reveal-delay-2">
            <span class="feature-symbol">◒</span>
            <h3>Visible results</h3>
            <p>LCSC previews, conversion state and diagnostics stay in view.</p>
          </article>
          <article class="feature-card feature-card-lilac reveal">
            <span class="feature-symbol">⌘</span>
            <h3>GUI + CLI</h3>
            <p>
              A Qt 6 interface when you want it, a command line when you need
              automation.
            </p>
          </article>
          <article class="feature-card feature-card-yellow reveal reveal-delay-1">
            <span class="feature-symbol">↗</span>
            <h3>Settings remembered</h3>
            <p>Open it again and continue from the state you know.</p>
          </article>
        </div>
      </section>
      <section
        class="platforms section shell"
        aria-labelledby="platforms-title"
      >
        <div class="platform-intro reveal">
          <p class="kicker">PLATFORM STATUS</p>
          <h2 id="platforms-title">
            macOS packages,{" "}
            <br />
            <em>still experimental.</em>
          </h2>
          <p class="platform-summary">
            The current stable release provides packages for Windows, Linux and
            macOS; macOS builds have not completed maintainer validation. Choose
            the download that matches your architecture.
          </p>
          <a class="text-link text-link-down platform-intro-link" href="#download">See platform downloads <span>↓</span></a>
        </div>
        <PlatformAvailability language="en" platforms={platformAvailability} />
      </section>
      <section
        id="download"
        class="download section shell"
        aria-labelledby="download-title"
      >
        <div class="download-card reveal">
          <div class="download-orbit orbit-one"></div>
          <div class="download-orbit orbit-two"></div>
          <div class="download-copy">
            <p class="kicker">READY WHEN YOU ARE</p>
            <h2 id="download-title">
              Let the next board{" "}
              <br />
              <em>start sooner.</em>
            </h2>
            <p>
              Current stable <strong data-release-version>{latestRelease.tag}</strong> ·
              Free · GPL-3.0
            </p>
            <p class="download-platform-notice">
              The macOS build has not completed maintainer validation. An Apple Silicon user reported Gatekeeper’s
              “damaged or incomplete” warning. <a href="https://github.com/EasyKiconverter/EasyKiConverter/issues/153" target="_blank" rel="noreferrer">See the known issue <span aria-hidden="true">↗</span></a>.
              Do not disable macOS security protections based on unverified advice.
            </p>
            <div class="download-actions">
              <a
                class="button button-light magnetic"
                data-release-link
                href={latestRelease.url}
                target="_blank"
                rel="noreferrer"
              >
                View downloads for {latestRelease.tag} <span>↗</span>
              </a>
              <a
                class="download-link download-link-external"
                href="https://github.com/EasyKiconverter/EasyKiConverter/releases"
                target="_blank"
                rel="noreferrer"
              >
                All releases <span>↗</span>
              </a>
            </div>
            <div class="download-links" aria-label="Platform download entries">
              {latestRelease.assets.windows.map((asset, index) => <a data-release-asset={`windows-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>Windows</b><span>{asset.label}</span></a>)}
              {latestRelease.assets.linux.map((asset, index) => <a data-release-asset={`linux-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>Linux</b><span>{asset.label}</span></a>)}
              {latestRelease.assets.macos.map((asset, index) => <a data-release-asset={`macos-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>macOS</b><span>{asset.label}</span></a>)}
              <a
                data-release-asset="checksum"
                href={latestRelease.checksumUrl}
                target="_blank"
                rel="noreferrer"
              >
                <b>SHA256 checks</b>
                <span>SHA256SUMS ↗</span>
              </a>
            </div>
            <small>
              The website does not host large binaries. Choose the direct
              architecture download below; the current Release lists portable
              builds, MSIX, RPM, Arch Linux packages, and per-file checksums.
              Review its notes and verify SHA256 before installing; stable
              downloads remain available if the version lookup is temporarily
              unavailable.
            </small>
          </div>
          <div class="download-stamp">
            <span>
              OPEN{" "}
              <br />
              SOURCE
            </span>
            <b>✳</b>
            <span>
              MADE FOR{" "}
              <br />
              ENGINEERS
            </span>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter lang="en" homeHref="#top" />
    <script>
      import "../../js/app.ts";
    </script>
  </body>
</html>
