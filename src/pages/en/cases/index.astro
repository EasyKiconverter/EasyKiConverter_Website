---
import "../../../css/styles.css";
import "../../../css/accessibility.css";
import "../../../css/cases.css";
import ContentPage from "../../../layouts/ContentPage.astro";
import CaseStudies from "../../../components/CaseStudies.astro";

const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("en/cases/", siteBase);
const chineseUrl = new URL("cases/", siteBase);
---

<ContentPage
  lang="en"
  pageUrl={pageUrl}
  alternateUrl={chineseUrl}
  title="EasyKiConverter · Conversion Cases"
  description="Traceable EasyKiConverter conversion cases and test evidence."
>
  <CaseStudies lang="en" />
</ContentPage>
