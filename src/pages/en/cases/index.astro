---
import "../../../css/styles.css";
import "../../../css/accessibility.css";
import "../../../css/cases.css";
import CaseStudies from "../../../components/CaseStudies.astro";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("en/cases/", siteBase);
const chineseUrl = new URL("cases/", siteBase);
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Traceable EasyKiConverter conversion cases and test evidence." /><link rel="canonical" href={pageUrl} /><link rel="alternate" hreflang="zh-CN" href={chineseUrl} /><link rel="alternate" hreflang="en" href={pageUrl} /><link rel="alternate" hreflang="x-default" href={chineseUrl} /><title>EasyKiConverter · Conversion Cases</title></head><body><header class="site-header shell"><a class="brand" href={siteBase.href}>EasyKiConverter</a><nav class="nav-links" aria-label="Page navigation"><a href={siteBase.href}>Home</a><a href={new URL("en/formats/", siteBase)}>Formats</a><a href={new URL("en/lab/", siteBase)}>3D Lab</a><a href={chineseUrl}>中文</a></nav></header><main><CaseStudies lang="en" /></main><footer class="site-footer shell"><p>© EasyKiConverter · GPL-3.0</p><a href={siteBase.href}>Return home</a></footer></body></html>
