---
import "../css/styles.css";
import "../css/accessibility.css";
import "../css/easter-eggs.css";
import "../css/home-polish.css";
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ProductStage from "../components/ProductStage.astro";
import ConversionScene from "../components/ConversionScene.astro";
import PlatformAvailability from "../components/PlatformAvailability.astro";
import ShowcaseCaption from "../components/ShowcaseCaption.astro";
import WorkbenchActions from "../components/WorkbenchActions.astro";
import WorkflowActions from "../components/WorkflowActions.astro";
import { targetFormats } from "../data/formats";
import { getPlatformAvailability } from "../data/platforms";
import { latestRelease } from "../data/release";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const chineseUrl = siteBase.href;
const englishUrl = new URL("en/", siteBase).href;
const socialImageUrl = new URL(
  "assets/showcase/easykiconverter-main-public.webp",
  siteBase,
).href;
const appImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easykiconverter-main-public.webp`;
const modelImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easyki-real-model-hero.webp`;
const exportImageUrl = `${import.meta.env.BASE_URL}assets/showcase/easykiconverter-export.webp`;
const primaryFormats = targetFormats.filter((format) => format.tier === "primary");
const additionalFormatCount = targetFormats.filter((format) => format.tier === "registered").length;
const localizeAssetLabel = (label: string) => label
  .replace(" installer", " 安装包")
  .replace("Apple Silicon", "Apple 芯片");
const platformAvailability = getPlatformAvailability("zh");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      lang="zh-CN"
      pageUrl={new URL(chineseUrl)}
      alternateUrl={new URL(englishUrl)}
      title="EasyKiConverter · 让元件库转换顺手一点"
      description="从 LCSC / EasyEDA 到你的 EDA 工作台。免费、开源、跨平台。"
      socialImageUrl={new URL(socialImageUrl)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        name: "EasyKiConverter",
        applicationCategory: "DeveloperApplication",
        operatingSystem: "Windows, Linux, macOS",
        softwareVersion: latestRelease.version,
        license: "https://www.gnu.org/licenses/gpl-3.0.html",
        downloadUrl:
          "https://github.com/EasyKiconverter/EasyKiConverter/releases",
        url: chineseUrl,
        codeRepository: "https://github.com/EasyKiconverter/EasyKiConverter",
        description:
          "Convert LCSC and EasyEDA component data into practical KiCad and Altium libraries with GUI and CLI workflows.",
      })}
    ></script>
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <a class="skip-link" href="#top">跳转到正文</a>
    <SiteHeader lang="zh-CN" variant="home" homeHref="#top" alternateUrl={new URL(englishUrl)} />
    <main id="top" tabindex="-1">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="hero-copy reveal">
          <p class="kicker">开源 · <span class="kicker-brand-case">Qt</span> 6 桌面工具</p>
          <h1 id="hero-title">
            让元件库<span class="hero-title-conversion">转换</span>，<em>顺手一点。</em>
          </h1>
          <p class="hero-lede">
            把 LCSC / EasyEDA 元件数据整理为 KiCad、Altium 可用的符号、封装与 3D 模型。
          </p>
          <div class="hero-actions">
            <a
              class="button button-dark magnetic"
              data-release-link
              href={latestRelease.url}
              target="_blank"
              rel="noreferrer"
            >
              {latestRelease.tag} 下载项 <span>↗</span>
            </a>
            <a class="text-link text-link-down" href="#story">
              看看它如何工作 <span>↓</span>
            </a>
          </div>
          <div class="hero-facts">
            <span>
              <b data-release-version>{latestRelease.tag}</b> 当前稳定版
            </span>
            <span>
              <b>GPL-3.0</b> 开源许可
            </span>
            <span>
              <b>GUI + CLI</b> 两种方式
            </span>
          </div>
        </div>
        <ProductStage lang="zh" appImageUrl={appImageUrl} modelImageUrl={modelImageUrl} />
        <a class="scroll-cue" href="#story" aria-label="继续向下">
          <span></span>继续向下
        </a>
      </section>
      <div class="marquee" aria-hidden="true">
        <div>
          <span>符号</span>
          <i>✳</i>
          <span>封装</span>
          <i>✳</i>
          <span>EDA 库</span>
          <i>✳</i>
          <span>BOM</span>
          <i>✳</i>
          <span>GUI + CLI</span>
          <i>✳</i>
          <span>符号</span>
          <i>✳</i>
          <span>封装</span>
          <i>✳</i>
          <span>EDA 库</span>
          <i>✳</i>
        </div>
      </div>
      <section
        id="story"
        class="story section shell"
        aria-labelledby="story-title"
      >
        <div id="workflow" class="section-intro workflow-copy reveal">
          <p class="kicker">一条路径，三个阶段</p>
          <h2 id="story-title">
            从元件数据，
            <br />
            <em>到可用的 EDA 库。</em>
          </h2>
          <p>
            输入 LCSC 编号或 BOM，准备符号、封装与 3D 模型，再将目标格式带回 KiCad、Altium 等设计工作流。
          </p>
          <WorkflowActions lang="zh" />
        </div>
        <div class="story-rail" data-story-rail>
          <ConversionScene lang="zh" modelImageUrl={modelImageUrl} />
          <article class="story-card story-card-a reveal">
            <span class="story-index">01 / 输入</span>
            <h3>
              先把元件
              <br />
              带进来。
            </h3>
            <p>
              输入 LCSC 编号，或直接导入 BOM。剪贴板里的编号也不用重新整理。
            </p>
            <a class="story-link" href="cases/">查看真实案例 <span>→</span></a>
            <div class="story-pulse">
              C2040 <span>→</span>
            </div>
          </article>
          <article class="story-card story-card-b reveal reveal-delay-1">
            <span class="story-index">02 / 整理</span>
            <h3>
              符号、封装、
              <br />
              模型，一起准备。
            </h3>
            <p>下载数据、映射图层、处理 3D 文件，批量操作交给多线程。</p>
            <a class="story-link" href="lab/">进入 3D Lab <span>→</span></a>
            <div class="story-stack">
              <b>符号</b>
              <b>封装</b>
              <b>3D 模型</b>
            </div>
          </article>
          <article class="story-card story-card-c reveal reveal-delay-2">
            <span class="story-index">03 / 交付</span>
            <h3>
              带回目标
              <br />
              EDA 继续设计。
            </h3>
            <p>生成对应格式的库文件，核对转换结果，然后在目标 EDA 中继续设计。</p>
            <a class="story-link" href="formats/">核对格式支持 <span>→</span></a>
            <div class="story-check">✓ 库文件已生成</div>
          </article>
        </div>
      </section>
      <section
        class="product-showcase section shell"
        aria-labelledby="showcase-title"
      >
        <div class="section-intro section-intro-wide reveal">
          <p class="kicker">真实的工作台</p>
          <h2 id="showcase-title">
            这不是概念图。
            <br />
            <em>这是真实界面。</em>
          </h2>
          <p>
            首屏展示元件与 BOM 输入；这里接着呈现真实导出设置、处理进度和元件结果，
            串起从准备到交付的工作流。
          </p>
        </div>
        <figure class="app-window reveal">
          <div class="window-chrome">
            <span class="window-icon">
              <img src="assets/icons/easyki-icon.svg" alt="" />
            </span>
            <b>EasyKiConverter</b>
            <span class="window-spacer"></span>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <img
            src={exportImageUrl}
            alt="EasyKiConverter 实际 Qt Quick 导出界面，展示导出设置、处理进度和元件结果；本机输出路径已隐藏"
            loading="lazy"
          />
          <ShowcaseCaption lang="zh" imageUrl={exportImageUrl} />
        </figure>
        <WorkbenchActions lang="zh" />
      </section>
      <section
        id="features"
        class="features section shell"
        aria-labelledby="features-title"
      >
        <div class="section-heading reveal">
          <div>
            <p class="kicker">一款得体的工具</p>
            <h2 id="features-title">
              把繁琐的部分，
              <br />
              <em>做得体面一点。</em>
            </h2>
          </div>
          <p>
            功能都围绕真实的电子工程工作流展开：不假装替你设计，只替你省下机械操作。
          </p>
        </div>
        <div class="feature-grid">
          <article id="formats" class="feature-card feature-card-large reveal">
            <span class="feature-number">01</span>
            <div>
              <h3>多目标输出</h3>
              <p>
                当前稳定版以 KiCad、Altium 为主要目标；其他目标格式的具体支持范围，请查看对应版本的发布说明和格式矩阵。
              </p>
              <div class="format-pills" data-format-summary>
                {primaryFormats.map((format) => <b>{format.name}</b>)}
                <b>+ {additionalFormatCount} 个其他目标</b>
              </div>
              <div class="feature-links" aria-label="格式与案例入口">
                <a class="feature-link feature-link-internal feature-link-primary" href="formats/">查看格式矩阵 <span>→</span></a>
                <a class="feature-link feature-link-internal feature-link-secondary" href="cases/">查看真实转换案例 <span>→</span></a>
              </div>
            </div>
          </article>
          <article class="feature-card feature-card-mint reveal reveal-delay-1">
            <span class="feature-symbol">⌁</span>
            <h3>批量而不吵闹</h3>
            <p>BOM 导入、多线程处理与自动记住设置，让大批量任务更从容。</p>
          </article>
          <article class="feature-card feature-card-peach reveal reveal-delay-2">
            <span class="feature-symbol">◒</span>
            <h3>看得见结果</h3>
            <p>LCSC 预览图、转换状态和诊断信息，都在界面里保持可见。</p>
          </article>
          <article class="feature-card feature-card-lilac reveal">
            <span class="feature-symbol">⌘</span>
            <h3>GUI + CLI</h3>
            <p>想点选时有 Qt 6 界面，需要自动化时也有命令行。</p>
          </article>
          <article class="feature-card feature-card-yellow reveal reveal-delay-1">
            <span class="feature-symbol">↗</span>
            <h3>不把设置忘掉</h3>
            <p>配置自动保存，下次打开时从你熟悉的状态继续。</p>
          </article>
        </div>
      </section>
      <section
        class="platforms section shell"
        aria-labelledby="platforms-title"
      >
        <div class="platform-intro reveal">
          <p class="kicker">平台状态</p>
          <h2 id="platforms-title">
            macOS 安装包，
            <br />
            <em>仍属实验阶段。</em>
          </h2>
          <p class="platform-summary">当前稳定版提供 Windows、Linux 和 macOS 安装包；macOS 构建尚未完成维护者验收，请按设备架构选择对应下载项。</p>
          <a class="text-link text-link-down platform-intro-link" href="#download">查看平台下载项 <span>↓</span></a>
        </div>
        <PlatformAvailability language="zh" platforms={platformAvailability} />
      </section>
      <section
        id="download"
        class="download section shell"
        aria-labelledby="download-title"
      >
        <div class="download-card reveal">
          <div class="download-orbit orbit-one"></div>
          <div class="download-orbit orbit-two"></div>
          <div class="download-copy">
            <p class="kicker">随时可以开始</p>
            <h2 id="download-title">
              让下一块板，
              <br />
              <em>早点开始。</em>
            </h2>
            <p>
              当前稳定版 <strong data-release-version>{latestRelease.tag}</strong> · 免费 ·
              GPL-3.0
            </p>
            <p class="download-platform-notice">
              macOS 构建尚未完成维护者验收。Apple Silicon 用户曾报告 Gatekeeper 提示“应用已损坏或不完整”。
              <a href="https://github.com/EasyKiconverter/EasyKiConverter/issues/153" target="_blank" rel="noreferrer">查看已知问题 <span aria-hidden="true">↗</span></a>。请勿根据未经核实的教程关闭系统安全防护。
            </p>
            <div class="download-actions">
              <a
                class="button button-light magnetic"
                data-release-link
                href={latestRelease.url}
                target="_blank"
                rel="noreferrer"
              >
                查看 {latestRelease.tag} 下载项 <span>↗</span>
              </a>
              <a
                class="download-link download-link-external"
                href="https://github.com/EasyKiconverter/EasyKiConverter/releases"
                target="_blank"
                rel="noreferrer"
              >
                查看全部发布版本 <span>↗</span>
              </a>
            </div>
            <div class="download-links" aria-label="平台下载入口">
              {latestRelease.assets.windows.map((asset, index) => <a data-release-asset={`windows-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>Windows</b><span>{localizeAssetLabel(asset.label)}</span></a>)}
              {latestRelease.assets.linux.map((asset, index) => <a data-release-asset={`linux-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>Linux</b><span>{localizeAssetLabel(asset.label)}</span></a>)}
              {latestRelease.assets.macos.map((asset, index) => <a data-release-asset={`macos-${index}`} href={asset.url} target="_blank" rel="noreferrer"><b>macOS</b><span>{localizeAssetLabel(asset.label)}</span></a>)}
              <a
                data-release-asset="checksum"
                href={latestRelease.checksumUrl}
                target="_blank"
                rel="noreferrer"
              >
                <b>SHA256 校验</b>
                <span>SHA256SUMS ↗</span>
              </a>
            </div>
            <small>官网不托管大型安装包。请选择匹配设备架构的直达下载；便携版、MSIX、RPM、Arch Linux 包及逐项校验文件见当前版本发布页。安装前请阅读发布说明并核对 SHA256；版本信息暂不可用时，稳定版下载入口仍有效。</small>
          </div>
          <div class="download-stamp" aria-hidden="true">
            <span>
              开源
              <br />
              工具
            </span>
            <b>✳</b>
            <span>
              为
              <br />
              工程师而做
            </span>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter lang="zh-CN" homeHref="#top" />
    <div class="egg-toast" role="status" aria-live="polite"></div>
    <script>
      import "../js/app.ts";
    </script>
  </body>
</html>
