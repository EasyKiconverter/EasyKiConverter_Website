---
import "../../css/styles.css";
import "../../css/accessibility.css";
import "../../css/cases.css";
import ContentPage from "../../layouts/ContentPage.astro";
import CaseStudies from "../../components/CaseStudies.astro";

const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const pageUrl = new URL("cases/", siteBase);
const englishUrl = new URL("en/cases/", siteBase);
---

<ContentPage
  lang="zh-CN"
  pageUrl={pageUrl}
  alternateUrl={englishUrl}
  title="EasyKiConverter · 真实转换案例"
  description="EasyKiConverter 可追溯真实转换案例与测试证据。"
>
  <CaseStudies lang="zh" />
</ContentPage>
