---
interface Props { lang: 'zh' | 'en'; }
const { lang } = Astro.props;
const en = lang === 'en';
const appImage = `${import.meta.env.BASE_URL}assets/showcase/easykiconverter-main-public.webp`;
const modelPoster = `${import.meta.env.BASE_URL}assets/showcase/easyki-lab-model-poster.webp`;
const mobileModelPoster = `${import.meta.env.BASE_URL}assets/showcase/easyki-lab-model-poster-mobile.webp`;
---

<section class="motion-narrative" id="story" data-motion-timeline aria-label={en ? 'From component data to design' : '从元件数据到电路设计'}>
  <div class="motion-pin">
    <div class="motion-heading">
      <p class="kicker">{en ? 'ONE COMPONENT, A NEW SHAPE' : '同一个元件，新的形状'}</p>
      <h1>{en ? <>Component conversion,{" "}<br /><em>made tangible.</em></> : <>让元件库转换，<br /><em>顺手一点。</em></>}</h1>
      <p>{en ? 'Follow one real component from LCSC / EasyEDA into the EDA tools you already use.' : '跟随一个真实元件，从 LCSC / EasyEDA 出发，走进你熟悉的 EDA 工作流。'}</p>
    </div>

    <div class="motion-model" data-model-stage data-artifact-view="model">
      <div class="motion-model-note"><span class="live-dot"></span><span data-artifact-label>{en ? 'GLB DELIVERY MODEL' : 'GLB 交付模型'}</span><small>01 / 04</small></div>
      <div class="model-detail-status" data-model-detail-status aria-live="polite">{en ? 'SURFACE DETAIL · LOADING' : '表面细节 · 加载中'}</div>
      <picture class="model-loading-poster" data-model-poster aria-hidden="true">
        <source media="(max-width: 760px)" srcset={mobileModelPoster} type="image/webp" />
        <img src={modelPoster} alt="" width="1400" height="1298" loading="eager" decoding="async" />
      </picture>
      <div class="model-loading-state" role="status" aria-live="polite">
        <span class="model-loading-orbit" aria-hidden="true"></span>
        <span>{en ? 'Preparing the real 3D model…' : '正在准备真实 3D 模型…'}</span>
      </div>
      <div class="neural-memory-readout" data-neural-memory aria-live="polite">{en ? 'SYNAPTIC MEMORY · 0 PATHS' : '突触记忆 · 0 条路径'}</div>
      <div class="swarm-lineage-readout" data-swarm-lineage-readout aria-live="polite">{en ? 'LINEAGE ∞ 0' : '谱系 ∞ 0'}</div>
      <div class="swarm-lineage-picker" data-swarm-lineage-picker role="group" aria-label={en ? 'Recall an archived topology genome' : '回溯已归档的拓扑基因'}></div>
      <canvas id="model-canvas" tabindex="0" aria-keyshortcuts="ArrowUp ArrowDown ArrowLeft ArrowRight Escape" aria-label={en ? 'Interactive GLB delivery model generated from STEP geometry. Click a part or focus this canvas and use the arrow keys to explore neighboring components in screen space. Escape restores the full material view.' : '由 STEP 几何生成的交互式 GLB 交付模型。点击零件，或聚焦此画布后用方向键按屏幕空间探索相邻零件。按 Esc 恢复完整材质视图。'}></canvas>
      <canvas class="mesh-atlas" data-mesh-atlas tabindex="0" inert aria-hidden="true" aria-label={en ? 'Spatial atlas of the real STEP meshes. Use arrow keys to move focus, Enter to inspect a part, and Escape to clear focus.' : '真实 STEP 网格的空间星图。使用方向键移动焦点，按 Enter 检查零件，按 Esc 清除焦点。'}></canvas>
      <canvas class="model-tomogram" data-model-tomogram inert aria-hidden="true" role="img" aria-label={en ? 'Live tomogram accumulated from cross-sections of the real STEP geometry. Start a CT scan to reveal its internal profile.' : '由真实 STEP 几何剖面累积生成的实时断层图。启动 CT 扫描以显现内部轮廓。'}></canvas>
      <canvas class="model-oracle" data-model-oracle tabindex="0" inert aria-hidden="true" role="img" aria-label={en ? 'Topology DNA oracle generated from recorded real STEP section frames. Drag horizontally to scrub frames and vertically to mutate the helix.' : '由真实 STEP 截面帧生成的拓扑 DNA 预言图。横向拖动浏览帧，纵向拖动改变螺旋突变强度。'}></canvas>
      <canvas class="model-trinity" data-model-trinity tabindex="0" inert aria-hidden="true" role="img" aria-label={en ? 'Three-track comparison of topology parent A, parent B, and the recombined timeline. Click a position to jump to that real section.' : '拓扑父时间线 A、父时间线 B 与重组时间线的三轨对照图。点击位置可跳转到真实截面。'}></canvas>
      <canvas class="model-morph" data-model-morph tabindex="0" inert aria-hidden="true" role="img" aria-label={en ? 'Interactive topology morph field. Drag across the field to scrub real STEP section history.' : '交互式拓扑形变场。拖动形变场以浏览真实 STEP 截面历史。'}></canvas>

      <div class="genome-arena-board" data-genome-arena-board hidden aria-live="polite">
        <span>{en ? 'TOPOLOGY ARENA' : '拓扑竞技场'}</span><b data-genome-arena-seats>{en ? '0 SEATS' : '0 席位'}</b>
        <ol data-genome-arena-list></ol>
        <small>{en ? 'RECENT ROUNDS · CLICK TO REPLAY' : '最近回合 · 点击回放'}</small><ul data-genome-arena-history></ul>
        <small>{en ? 'SEASON BRACKET' : '赛季淘汰树'}</small><ol class="genome-season-bracket" data-genome-season-bracket></ol>
        <div class="genome-arena-timeline" data-genome-arena-timeline hidden>
          <label for={en ? 'arena-replay-time-en' : 'arena-replay-time-zh'}>{en ? 'REPLAY TIME' : '回放时间'} <output data-genome-arena-time>100%</output></label>
          <input id={en ? 'arena-replay-time-en' : 'arena-replay-time-zh'} type="range" min="0" max="100" value="100" data-genome-arena-time-slider aria-label={en ? 'Scrub arena replay time' : '拖动竞技回放时间'} />
          <button type="button" data-genome-arena-mix aria-pressed="false" aria-label={en ? 'Play recent arena rounds as a continuous replay mix' : '连续播放最近竞技回合混剪'}>{en ? 'MIX ▶' : '混剪 ▶'}</button>
          <button type="button" data-genome-arena-bridge-duel disabled aria-label={en ? 'Challenge the generated bridge genome' : '挑战刚生成的桥接基因'}>{en ? 'BRIDGE ⚔' : '桥接 ⚔'}</button>
          <button type="button" data-genome-arena-ascend disabled aria-label={en ? 'Evolve a new genome from the bridge duel winner' : '从桥接决斗胜者进化新基因'}>{en ? 'ASCEND ✦' : '进阶 ✦'}</button>
          <button type="button" data-genome-arena-season disabled aria-label={en ? 'Crown the current topology season champion' : '加冕当前拓扑赛季冠军'}>{en ? 'SEASON ♛' : '赛季 ♛'}</button>
          <button type="button" data-genome-arena-challenge disabled aria-label={en ? 'Challenge the crowned season champion with the strongest rival' : '让最强对手挑战赛季冠军'}>{en ? 'CHALLENGE ⚔' : '挑战 ⚔'}</button>
        </div>
      </div>
      <input type="file" accept="image/svg+xml,.svg" data-morph-genome-input hidden />
      <input type="file" accept="application/json,.json" data-causal-orbit-input hidden />
      <span class="tomogram-specimen-label" data-tomogram-specimen-label aria-hidden="true"><span>{en ? 'LIVE SPECIMEN' : '实时标本'}</span><b data-tomogram-axis-label>{en ? 'X SECTION' : 'X 向切片'}</b></span>
      <div class="tomogram-telemetry" data-tomogram-telemetry role="group" aria-label={en ? 'Cross-section measurements' : '真实截面测量值'}>
        <span><small>{en ? 'AREA' : '面积'}</small><b data-tomogram-area>—</b><i>mm²</i></span>
        <span><small>{en ? 'PERIMETER' : '周长'}</small><b data-tomogram-perimeter>—</b><i>mm</i></span>
        <span><small>{en ? 'CLOSED LOOPS' : '闭合环'}</small><b data-tomogram-loops>—</b><i></i></span>
        <span><small>{en ? 'TOPOLOGY' : '拓扑'}</small><b data-tomogram-topology>—</b><i></i></span>
        <span><small>{en ? 'Δ AREA' : '面积差'}</small><b data-tomogram-delta>—</b><i>mm²</i></span>
        <button type="button" class="tomogram-mesh-link" data-tomogram-reveal-atlas aria-label={en ? 'Show the meshes crossed by this section in the spatial atlas' : '在空间星图中查看当前剖面穿过的网格'} title={en ? 'Reveal intersecting meshes in the atlas' : '在星图中查看相交网格'}>
          <small>{en ? 'MESHES ↗' : '网格 ↗'}</small><b data-tomogram-meshes>—</b><i></i>
        </button>
      </div>
      <div class="tomogram-toolbar" role="group" aria-label={en ? 'Tomogram tools' : '断层视图工具'}>
        <button type="button" class="tomogram-pin" data-tomogram-pin disabled aria-pressed="false" aria-label={en ? 'Pin the current section, then move the slice to compare geometry' : '固定当前截面，然后移动切片比较几何变化'} title={en ? 'Pin a section for difference comparison' : '固定截面用于差分比较'}>PIN Δ</button>
        <button type="button" class="tomogram-export" data-tomogram-export disabled aria-label={en ? 'Export the current closed section contours as an SVG file' : '将当前闭合截面轮廓导出为 SVG 文件'} title={en ? 'Export vector section profile' : '导出矢量截面轮廓'}>SVG ↓</button>
        <button type="button" class="tomogram-movie" data-tomogram-movie disabled aria-label={en ? 'Export recorded section frames as an animated SVG' : '将已录制截面帧导出为 SVG 动画'} title={en ? 'Export geometry movie' : '导出几何电影'}>{en ? 'MOVIE ↓' : '动画 ↓'}</button>
        <button type="button" class="tomogram-forecast" data-tomogram-forecast disabled aria-pressed="false" aria-label={en ? 'Project the next section from recent real STEP frames' : '根据最近真实 STEP 帧预测下一个截面'} title={en ? 'Project the next real section' : '预测下一个真实截面'}>{en ? 'FUTURE ◌' : '未来 ◌'}</button>
        <button type="button" class="tomogram-branches" data-tomogram-branches disabled aria-pressed="false" aria-label={en ? 'Cycle through three possible future section branches' : '循环查看三个可能的未来截面分支'} title={en ? 'Cycle future branches' : '循环未来分支'}>{en ? 'BRANCH ∞' : '分支 ∞'}</button>
        <button type="button" class="tomogram-events" data-tomogram-events disabled aria-label={en ? 'Export topology events as a diagnostic narrative' : '导出拓扑事件诊断叙事'} title={en ? 'Export topology event narrative' : '导出拓扑事件叙事'}>{en ? 'EVENTS ↓' : '事件 ↓'}</button>
        <button type="button" class="tomogram-import" data-tomogram-import aria-label={en ? 'Import an EasyKiConverter section time capsule' : '导入 EasyKiConverter 截面时间胶囊'} title={en ? 'Import section history JSON' : '导入截面历史 JSON'}>{en ? 'IMPORT ↥' : '导入 ↥'}</button>
        <button type="button" class="tomogram-play" data-tomogram-play disabled aria-pressed="false" aria-label={en ? 'Play recorded section frames' : '播放已录制截面帧'}>{en ? 'PLAY ▶' : '播放 ▶'}</button>
        <button type="button" class="tomogram-hop" data-tomogram-hop disabled aria-label={en ? 'Jump to the next topology event' : '跳转到下一个拓扑事件'} title={en ? 'Jump between topology events' : '在拓扑事件之间跳转'}>{en ? 'HOP ↠' : '跳转 ↠'}</button>
        <button type="button" class="tomogram-arc" data-tomogram-arc disabled aria-label={en ? 'Play the topology event arc' : '播放拓扑事件弧线'} title={en ? 'Play event arc' : '播放事件弧'}>{en ? 'ARC ▶' : '事件弧 ▶'}</button>
        <button type="button" class="tomogram-reel" data-tomogram-reel disabled aria-pressed="false" aria-label={en ? 'Record the topology event arc as WebM' : '将拓扑事件弧线录制为 WebM'} title={en ? 'Record event reel' : '录制事件短片'}>{en ? 'REEL ●' : '短片 ●'}</button>
        <button type="button" class="tomogram-multiverse" data-tomogram-multiverse disabled aria-pressed="false" aria-label={en ? 'Blend imported topology histories as a multiverse interference field' : '将导入的拓扑历史混合为多宇宙干涉场'} title={en ? 'Blend imported histories' : '混合导入的历史'}>{en ? 'MIX ∞' : '混合 ∞'}</button>
        <button type="button" class="tomogram-splice" data-tomogram-splice disabled aria-pressed="false" aria-label={en ? 'Recombine two imported topology histories into a hybrid timeline' : '将两条导入的拓扑历史重组为混合时间线'} title={en ? 'Recombine histories' : '重组历史'}>{en ? 'SPLICE 🧬' : '拼接 🧬'}</button>
        <button type="button" class="tomogram-audio" data-tomogram-audio disabled aria-pressed="false" aria-label={en ? 'Sonify topology events' : '将拓扑事件转化为声音'} title={en ? 'Turn topology into sound' : '让拓扑发声'}>{en ? 'SOUND ♫' : '声音 ♫'}</button>
        <button type="button" class="tomogram-cinema" data-tomogram-cinema disabled aria-pressed="false" aria-label={en ? 'Replay the locked topology event across all views' : '在所有视图中回放锁定的拓扑事件'} title={en ? 'Replay event capsule' : '回放事件胶囊'}>{en ? 'CINEMA ◉' : '影院 ◉'}</button>
        <button type="button" class="tomogram-share" data-tomogram-share disabled aria-label={en ? 'Copy a link to the selected topology event' : '复制当前拓扑事件链接'} title={en ? 'Copy event deep link' : '复制事件深链接'}>{en ? 'SHARE ↗' : '分享 ↗'}</button>
        <button type="button" class="tomogram-record" data-tomogram-record disabled aria-pressed="false" aria-label={en ? 'Record section frames while scanning' : '扫描时录制截面帧'}>{en ? 'REC ●' : '录制 ●'}</button>
      </div>
      <label class="tomogram-scrubber" data-tomogram-scrubber>
        <span class="tomogram-scrubber-title">{en ? 'SLICE' : '切片'}</span>
        <input type="range" min="0" max="100" value="50" step="1" data-tomogram-scrubber-range aria-label={en ? 'Scrub the CT section position' : '拖动以检查 CT 切片位置'} disabled />
        <output data-tomogram-scrubber-value aria-hidden="true">50%</output>
      </label>
      <label class="tomogram-frame-scrubber" data-tomogram-frame-scrubber>
        <span class="tomogram-scrubber-title">{en ? 'FRAME' : '帧'}</span>
        <input type="range" min="0" max="0" value="0" step="1" data-tomogram-frame-range aria-label={en ? 'Scrub the recorded section timeline' : '拖动已录制截面时间轴'} disabled />
        <output data-tomogram-frame-value aria-hidden="true">—</output>
      </label>
      <label class="tomogram-crossover" data-tomogram-crossover>
        <span class="tomogram-scrubber-title">{en ? 'CROSSOVER' : '交叉点'}</span>
        <input type="range" min="5" max="95" value="50" step="1" data-tomogram-crossover-range aria-label={en ? 'Choose the crossover point for topology recombination' : '选择拓扑重组的基因交叉点'} disabled />
        <output data-tomogram-crossover-value aria-hidden="true">50%</output>
      </label>
      <label class="tomogram-crossover-end" data-tomogram-crossover-end>
        <span class="tomogram-scrubber-title">{en ? 'CROSSOVER B' : '交叉点 B'}</span>
        <input type="range" min="5" max="95" value="70" step="1" data-tomogram-crossover-end-range aria-label={en ? 'Choose the second crossover point for topology recombination' : '选择拓扑重组的第二个基因交叉点'} disabled />
        <output data-tomogram-crossover-end-value aria-hidden="true">70%</output>
      </label>
      <div class="tomogram-lineage" data-tomogram-lineage hidden>
        <div class="tomogram-lineage-head">
          <span class="tomogram-lineage-title">{en ? 'LINEAGE' : '谱系'}</span>
          <button type="button" class="tomogram-memory-pin" data-tomogram-memory-pin disabled aria-pressed="false" aria-label={en ? 'Pin the latest topology memory in 3D space' : '将最近的拓扑记忆固定在三维空间'}>{en ? 'PIN MEMORY' : '固定记忆'}</button>
        </div>
        <div class="tomogram-lineage-field" data-tomogram-lineage-field role="img" aria-label={en ? 'Topology genealogy field across recorded frames' : '已录制帧中的拓扑家谱场'}></div>
        <div class="tomogram-lineage-track" data-tomogram-lineage-track role="listbox" aria-label={en ? 'Selected topology loop area through recorded frames' : '选中拓扑环在已录制帧中的面积变化'}></div>
        <div class="tomogram-memory-rack" data-tomogram-memory-rack aria-label={en ? 'Pinned topology memories' : '已固定的拓扑记忆'}></div>
        <label class="tomogram-orbit-control">
          <span>{en ? 'ORBIT' : '轨道'}</span>
          <input type="range" min="0.5" max="2.4" step="0.1" value="1" data-tomogram-orbit-range aria-label={en ? 'Adjust topology memory orbit radius' : '调整拓扑记忆轨道半径'} disabled />
          <output data-tomogram-orbit-value>1×</output>
        </label>
        <label class="tomogram-orbit-control">
          <span>{en ? 'TIME' : '时间'}</span>
          <input type="range" min="0" max="3" step="0.1" value="1" data-tomogram-speed-range aria-label={en ? 'Adjust topology memory orbit speed' : '调整拓扑记忆轨道速度'} disabled />
          <output data-tomogram-speed-value>1×</output>
        </label>
        <label class="tomogram-orbit-control">
          <span>{en ? 'PART' : '部件'}</span>
          <input type="range" min="-3" max="3" step="0.1" value="1" data-tomogram-part-speed-range aria-label={en ? 'Adjust selected part memory time speed, negative reverses time' : '调整选中部件记忆时间速度，负值反向播放'} disabled />
          <output data-tomogram-part-speed-value>1×</output>
        </label>
        <label class="tomogram-orbit-control">
          <span>{en ? 'HISTORY' : '历史'}</span>
          <input type="range" min="0" max="100" step="1" value="100" data-tomogram-part-history-range aria-label={en ? 'Jump through selected part history' : '跳转选中部件的历史状态'} disabled />
          <output data-tomogram-part-history-value>100%</output>
        </label>
        <output data-tomogram-lineage-value aria-hidden="true">—</output>
      </div>
      <span class="tomogram-record-status" data-tomogram-record-status aria-live="polite">{en ? 'NO FRAMES' : '暂无帧'}</span>
      <input type="file" accept="application/json,.json" multiple data-tomogram-import-input hidden />
      <div class="artifact-visual" data-visual="symbol" aria-hidden="true">
        <svg viewBox="0 0 460 320" role="presentation">
          <g class="artifact-grid"><path d="M20 40H440M20 80H440M20 120H440M20 160H440M20 200H440M20 240H440M20 280H440M60 20V300M100 20V300M140 20V300M180 20V300M220 20V300M260 20V300M300 20V300M340 20V300M380 20V300M420 20V300" /></g>
          <g class="symbol-lines"><path d="M70 90H165M70 230H165M295 90H390M295 230H390M165 65V255H295V65Z" /><path d="M230 65V32M230 255V288M165 125H135M165 195H135M295 125H325M295 195H325" /></g>
          <g class="symbol-pins"><path d="M212 32H248M212 288H248M116 90V110M116 210V230M344 90V110M344 210V230" /></g>
          <g class="symbol-copy"><text x="230" y="145" text-anchor="middle">U1</text><text x="230" y="174" text-anchor="middle">EASYKI</text><text x="230" y="196" text-anchor="middle">{en ? 'COMPONENT' : '元件'}</text><text x="184" y="53">VCC</text><text x="188" y="280">GND</text><text x="73" y="82">IN</text><text x="352" y="82">OUT</text></g>
          <circle class="symbol-node" cx="116" cy="90" r="5"/><circle class="symbol-node" cx="344" cy="90" r="5"/><circle class="symbol-node" cx="116" cy="230" r="5"/><circle class="symbol-node" cx="344" cy="230" r="5"/>
        </svg>
      </div>
      <div class="artifact-visual" data-visual="footprint" aria-hidden="true">
        <svg viewBox="0 0 460 320" role="presentation">
          <g class="artifact-grid"><path d="M20 40H440M20 80H440M20 120H440M20 160H440M20 200H440M20 240H440M20 280H440M60 20V300M100 20V300M140 20V300M180 20V300M220 20V300M260 20V300M300 20V300M340 20V300M380 20V300M420 20V300" /></g>
          <rect class="footprint-body" x="116" y="54" width="228" height="212" rx="10" />
          <path class="footprint-silk" d="M132 70H328V250H132Z" />
          <path class="footprint-mark" d="M132 96A26 26 0 0 1 158 70" />
          <g class="footprint-pads">
            <rect x="67" y="77" width="34" height="18" rx="5"/><rect x="67" y="119" width="34" height="18" rx="5"/><rect x="67" y="161" width="34" height="18" rx="5"/><rect x="67" y="203" width="34" height="18" rx="5"/>
            <rect x="359" y="77" width="34" height="18" rx="5"/><rect x="359" y="119" width="34" height="18" rx="5"/><rect x="359" y="161" width="34" height="18" rx="5"/><rect x="359" y="203" width="34" height="18" rx="5"/>
          </g>
          <g class="footprint-copy"><text x="230" y="155" text-anchor="middle">U1</text><text x="230" y="180" text-anchor="middle">{en ? 'LAND PATTERN' : '封装焊盘'}</text><text x="230" y="238" text-anchor="middle">{en ? 'TOP VIEW · NOT TO SCALE' : '俯视图 · 非按比例'}</text></g>
        </svg>
      </div>
      <span class="artifact-scroll-description" id={`artifact-scroll-description-${en ? 'en' : 'zh'}`}>
        {en ? 'On narrow screens, scroll horizontally to see all component views.' : '窄屏下可横向滑动，查看全部元件视图。'}
      </span>
      <div class="model-view-controls">
      <div class="artifact-switcher" role="group" aria-label={en ? 'Choose a component view' : '选择元件视图'}>
        <button type="button" data-artifact-view="model" data-label-zh="GLB 交付模型" data-label-en="GLB DELIVERY MODEL" data-caption-zh="由 STEP 几何生成的 GLB · 随滚动进入产品叙事" data-caption-en="GLB generated from STEP geometry · connected to the scroll story" aria-pressed="true">{en ? '3D solid' : '3D 实体'}</button>
        <button type="button" data-artifact-view="symbol" data-label-zh="原理图符号示意" data-label-en="SCHEMATIC SYMBOL STUDY" data-caption-zh="原理图符号 · 视觉示意，并非导出的 CAD 数据" data-caption-en="Schematic symbol · visual study, not exported CAD data" aria-pressed="false">{en ? 'Symbol' : '符号'}</button>
        <button type="button" data-artifact-view="footprint" data-label-zh="PCB 封装示意" data-label-en="PCB FOOTPRINT STUDY" data-caption-zh="PCB 封装 · 视觉示意，并非导出的 CAD 数据" data-caption-en="PCB footprint · visual study, not exported CAD data" aria-pressed="false">{en ? 'Footprint' : '封装'}</button>
      </div>
      <details class="research-view-disclosure">
        <summary>{en ? 'More views' : '更多视图'}</summary>
        <div class="research-view-panel">
