---
interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const en = lang === "en";
---

<figcaption>
  <div class="showcase-proof">
    <span class="showcase-proof-label">{en ? "REAL Qt Quick UI" : "真实 Qt Quick 界面"}</span>
    <span class="showcase-proof-items">
      {en ? "Set export options · Track progress · Review results" : "设置导出选项 · 查看处理进度 · 核对导出结果"}
    </span>
  </div>
  <small class="showcase-source">
    {en
      ? "Captured from the running desktop app · Local output path hidden"
      : "截取自桌面软件实际运行界面 · 本机输出路径已隐藏"}
  </small>
</figcaption>
