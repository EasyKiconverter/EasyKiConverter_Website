---
interface Props {
  lang: "zh" | "en";
}

const { lang } = Astro.props;
const en = lang === "en";
---

<figcaption>
  <div class="showcase-proof">
    <span class="showcase-proof-label">{en ? "REAL QT QUICK UI" : "真实 Qt Quick 界面"}</span>
    <span class="showcase-proof-items">
      {en ? "Add components · Import BOM · Set export" : "添加元件 · 导入 BOM · 设置导出"}
    </span>
  </div>
  <small class="showcase-source">
    {en ? "Source: main project resources/imgs/screenshot1.png" : "来源：主项目 resources/imgs/screenshot1.png"}
  </small>
</figcaption>
