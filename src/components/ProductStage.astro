---
interface Props {
  lang: "zh" | "en";
  appImageUrl: string;
  modelImageUrl: string;
}

const { lang, appImageUrl, modelImageUrl } = Astro.props;
const en = lang === "en";
---

<div
  class="hero-stage hero-product-stage reveal reveal-delay"
  data-product-stage
  aria-label={en ? "A real STEP-derived model moving from component data to an EDA library" : "真实 STEP 模型从元件数据走向 EDA 元件库"}
>
  <figure class="hero-product-window hero-model-window">
    <figcaption>
      <span>{en ? "STEP-DERIVED MODEL" : "STEP 几何模型"}</span>
      <span>{en ? "STATIC 3D PREVIEW" : "静态 3D 预览"}</span>
    </figcaption>
    <img
      src={modelImageUrl}
      alt={en ? "A component board rendered from the real STEP-derived GLB model, showing connectors, capacitors and surface-mount parts in three dimensions" : "由真实 STEP 派生 GLB 模型渲染的元件板，展示立体连接器、电容与贴片元件"}
      fetchpriority="high"
      width="1100"
      height="800"
    />
    <span class="hero-model-caption">{en ? "STEP → 3D MODEL" : "STEP → 3D 模型"}</span>
  </figure>

  <aside class="hero-float-card hero-float-input">
    <span class="hero-float-label">{en ? "01 · COMPONENT DATA" : "01 · 元件数据"}</span>
    <strong>{en ? "LCSC / BOM" : "LCSC / BOM"}</strong>
    <span class="hero-float-meta"><i></i>{en ? "Ready to organize" : "等待整理"}</span>
  </aside>

  <aside class="hero-float-card hero-float-output">
    <span class="hero-float-label">{en ? "02 · LIBRARY OUTPUT" : "02 · 元件库输出"}</span>
    <span class="hero-output-row"><i class="hero-output-symbol">⌁</i>{en ? "Symbol" : "符号"}<b>✓</b></span>
    <span class="hero-output-row"><i class="hero-output-footprint"></i>{en ? "Footprint" : "封装"}<b>✓</b></span>
    <span class="hero-output-row"><i class="hero-output-model"></i>{en ? "3D model" : "3D 模型"}<b>✓</b></span>
  </aside>

  <a class="hero-software-window" href={en ? "#showcase-title" : "#showcase-title"} aria-label={en ? "Jump to the real EasyKiConverter software screenshot" : "跳转查看 EasyKiConverter 真实软件界面"}>
    <img
      src={appImageUrl}
      alt=""
      loading="lazy"
    />
    <span>{en ? "REAL QT QUICK APP" : "真实 Qt Quick 软件"}</span>
  </a>

  <span class="hero-stage-tag">{en ? "COMPONENT DATA" : "元件数据"} <b>→</b> {en ? "EDA LIBRARY" : "EDA 库"}</span>
</div>
