---
import { caseStudies } from "../data/cases";
import { latestRelease } from "../data/release";
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const en = lang === "en";
const repository = "https://github.com/EasyKiconverter/EasyKiConverter";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const formatsUrl = new URL(en ? "en/formats/" : "formats/", siteBase).pathname;
const fileName = (path: string) => path.split("/").pop() ?? path;
const directoryName = (path: string) => path.slice(0, path.lastIndexOf("/")) + "/";
---

<section class="case-studies shell" aria-labelledby="case-studies-title">
  <div class="case-studies-heading">
    <p class="kicker">{en ? "TRACEABLE EXAMPLES" : "可追溯案例"}</p>
    <h1 id="case-studies-title">{en ? "Check the evidence, then trace each route." : "先核对证据，再看路径。"}</h1>
    <p>{en ? "Routes show only what linked tests verify. Generated data is distinguished from EasyEDA fixtures; desktop EDA checks remain manual." : "每条路径只描述其关联集成测试实际验证的内容。测试代码生成的数据会与 EasyEDA 样本明确区分；在桌面 EDA 软件中打开结果仍需人工检查。"}</p>
    <div class="case-studies-actions">
      <a class="button button-dark" href={formatsUrl}>{en ? "Compare formats" : "比较格式"} <span>→</span></a>
      <a class="text-link text-link-external" href={repository} target="_blank" rel="noreferrer">{en ? "View source" : "查看源码"} <span>↗</span></a>
    </div>
    <div class="evidence-summary" aria-label={en ? "Case evidence baseline" : "案例证据基线"}>
      <span><b>{latestRelease.tag}</b>{en ? " release baseline" : " 发布版本基线"}</span>
      <span><b>{caseStudies.length}</b>{en ? " traceable cases" : " 个可追溯案例"}</span>
    </div>
    <ol class="case-reading-guide" aria-label={en ? "How to read a case" : "案例阅读步骤"}>
      <li><span>01</span><div><b>{en ? "Choose a route" : "选定路径"}</b><small>{en ? "Start with the input → output pair." : "先确认输入 → 输出路径。"}</small></div></li>
      <li><span>02</span><div><b>{en ? "Inspect the input" : "核对输入依据"}</b><small>{en ? "Open the fixture or see how test data is generated." : "打开实际使用的样本，或查看测试数据的生成方式。"}</small></div></li>
      <li><span>03</span><div><b>{en ? "Review the test" : "复核测试"}</b><small>{en ? "Check the automated evidence before production use." : "用于生产前复核自动化证据。"}</small></div></li>
    </ol>
  </div>
  <div class="case-grid">
    {caseStudies.map((item, index) => <article class="case-card" id={item.id}>
      <span class="case-number">0{index + 1}</span>
      <span class="case-proof">{en ? "AUTOMATED EVIDENCE" : "自动化证据"}</span>
      <h2>{en ? item.titleEn : item.titleZh}</h2>
      <div class="case-route" aria-label={en ? "Case input and output" : "案例输入与输出"}>
        <span><small>{en ? "INPUT" : "输入"}</small><b>{en ? item.inputEn : item.inputZh}</b></span>
        <i aria-hidden="true">→</i>
        <span><small>{en ? "OUTPUT" : "输出"}</small><b>{en ? item.outputEn : item.outputZh}</b></span>
      </div>
      <p>{en ? item.summaryEn : item.summaryZh}</p>
      <dl>
        <div>
          <dt>{en ? "Input evidence" : "输入依据"}</dt>
          <dd>
            {item.fixtures.length > 0 ? (
              <div class="case-input-fixtures">
                {item.fixtures.map((fixture) => (
                  <a class="case-evidence-link" href={`${repository}/blob/master/${fixture}`} target="_blank" rel="noreferrer" aria-label={en ? `Open fixture ${fixture}` : `打开测试样本 ${fixture}`}>
                    <span class="case-evidence-action">{en ? "Open fixture" : "打开测试样本"} <span aria-hidden="true">↗</span></span>
                    <code><span class="case-evidence-name">{fileName(fixture)}</span><small class="case-evidence-directory">{directoryName(fixture)}</small></code>
                  </a>
                ))}
              </div>
            ) : (
              <p class="case-input-note">{en ? item.inputEvidenceEn : item.inputEvidenceZh}</p>
            )}
            {item.fixtures.length > 0 && <p class="case-input-note">{en ? item.inputEvidenceEn : item.inputEvidenceZh}</p>}
          </dd>
        </div>
        <div>
          <dt>{en ? "Test evidence" : "测试证据"}</dt>
          <dd><a class="case-evidence-link" href={`${repository}/blob/master/${item.test}`} target="_blank" rel="noreferrer" aria-label={en ? `Open test evidence ${item.test}` : `打开测试证据 ${item.test}`}><span class="case-evidence-action">{en ? "Open integration test" : "打开集成测试"} <span aria-hidden="true">↗</span></span><code><span class="case-evidence-name">{fileName(item.test)}</span><small class="case-evidence-directory">{directoryName(item.test)}</small></code></a></dd>
        </div>
      </dl>
    </article>)}
  </div>
  <p class="case-disclaimer">{en ? "Evidence scope: the linked fixtures and integration assertions only. Passing automated tests does not replace opening and checking exported files in KiCad, Altium, or another target EDA." : "证据范围仅限页面链接的测试样本与集成断言。自动化测试通过不等同于已在 KiCad、Altium 或其他目标 EDA 中打开并检查导出文件。"}</p>
</section>

<style>
  @media (max-width: 480px) {
    .case-studies-actions {
      flex-wrap: nowrap;
      gap: clamp(12px, 4vw, 16px);
    }

    .case-studies-actions > * {
      white-space: nowrap;
    }
  }

  @media (max-width: 360px) {
    .case-studies-actions {
      flex-wrap: wrap;
    }
  }
</style>
