---
import { caseStudies } from "../data/cases";
import { latestRelease } from "../data/release";
interface Props { lang: "zh" | "en"; }
const { lang } = Astro.props;
const en = lang === "en";
const repository = "https://github.com/EasyKiconverter/EasyKiConverter";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const formatsUrl = new URL(en ? "en/formats/" : "formats/", siteBase);
---

<section class="case-studies shell" aria-labelledby="case-studies-title">
  <div class="case-studies-heading">
    <p class="kicker">{en ? "TRACEABLE EXAMPLES" : "可追溯案例"}</p>
    <h1 id="case-studies-title">{en ? "From fixture to library." : "从测试样本，到库文件。"}</h1>
    <p>{en ? "These are evidence-led cases, not claims that every target supports every object. Follow the fixture and test links before treating a workflow as production-ready." : "这些是以证据为中心的案例，不代表每个目标格式支持所有对象。将某条流程用于生产前，请沿着测试样本和测试链接复核。"}</p>
    <div class="case-studies-actions">
      <a class="button button-dark" href={formatsUrl}>{en ? "Compare all targets" : "比较全部目标格式"} <span>→</span></a>
      <a class="text-link" href={repository} target="_blank" rel="noreferrer">{en ? "Open source evidence" : "打开源码证据"} <span>↗</span></a>
    </div>
    <div class="evidence-summary" aria-label={en ? "Case evidence baseline" : "案例证据基线"}>
      <span><b>{latestRelease.tag}</b>{en ? " release baseline" : " 发布版本基线"}</span>
      <span><b>{caseStudies.length}</b>{en ? " traceable cases" : " 个可追溯案例"}</span>
    </div>
    <ol class="case-reading-guide" aria-label={en ? "How to read a case" : "案例阅读步骤"}>
      <li><span>01</span><div><b>{en ? "Choose a route" : "选定路径"}</b><small>{en ? "Start with the input → output pair." : "先确认输入 → 输出路径。"}</small></div></li>
      <li><span>02</span><div><b>{en ? "Open the fixture" : "打开样本"}</b><small>{en ? "See the exact source data used by the case." : "查看案例使用的真实源数据。"}</small></div></li>
      <li><span>03</span><div><b>{en ? "Review the test" : "复核测试"}</b><small>{en ? "Check the automated evidence before production use." : "用于生产前复核自动化证据。"}</small></div></li>
    </ol>
  </div>
  <div class="case-grid">
    {caseStudies.map((item, index) => <article class="case-card" id={item.id}>
      <span class="case-number">0{index + 1}</span>
      <span class="case-proof">{en ? "AUTOMATED EVIDENCE" : "自动化证据"}</span>
      <h2>{en ? item.titleEn : item.titleZh}</h2>
      <div class="case-route" aria-label={en ? "Case input and output" : "案例输入与输出"}>
        <span><small>{en ? "INPUT" : "输入"}</small><b>{en ? item.inputEn : item.inputZh}</b></span>
        <i aria-hidden="true">→</i>
        <span><small>{en ? "OUTPUT" : "输出"}</small><b>{en ? item.outputEn : item.outputZh}</b></span>
      </div>
      <p>{en ? item.summaryEn : item.summaryZh}</p>
      <dl>
        <div><dt>{en ? "Fixture" : "测试样本"}</dt><dd><a class="case-evidence-link" href={`${repository}/blob/master/${item.fixture}`} target="_blank" rel="noreferrer" aria-label={en ? `Open fixture ${item.fixture}` : `打开测试样本 ${item.fixture}`}><span class="case-evidence-action">{en ? "Open fixture" : "打开测试样本"} <span aria-hidden="true">↗</span></span><code>{item.fixture}</code></a></dd></div>
        <div><dt>{en ? "Test evidence" : "测试证据"}</dt><dd><a class="case-evidence-link" href={`${repository}/blob/master/${item.test}`} target="_blank" rel="noreferrer" aria-label={en ? `Open test evidence ${item.test}` : `打开测试证据 ${item.test}`}><span class="case-evidence-action">{en ? "Open test evidence" : "打开测试证据"} <span aria-hidden="true">↗</span></span><code>{item.test}</code></a></dd></div>
      </dl>
    </article>)}
  </div>
  <p class="case-disclaimer">{en ? "Evidence scope: repository fixtures and automated integration tests. Manual validation in KiCad, Altium or another EDA is a separate release gate." : "证据范围：仓库测试样本与自动化集成测试。在 KiCad、Altium 或其他 EDA 中的人工验证属于独立的版本门禁。"}</p>
</section>
