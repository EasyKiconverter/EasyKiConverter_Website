---
interface Props {
  lang: "zh" | "en";
  modelImageUrl: string;
  modelUrl: string;
}

const { lang, modelImageUrl, modelUrl } = Astro.props;
const en = lang === "en";
---

<div class="conversion-scene" data-conversion-scene data-model-url={modelUrl} data-stage="input" aria-hidden="true">
  <figure class="conversion-scene-board">
    <figcaption>
      <span>{en ? "STEP-DERIVED GEOMETRY" : "STEP 派生几何"}</span>
      <span>{en ? "STATIC 3D PREVIEW" : "静态 3D 预览"}</span>
    </figcaption>
    <div class="conversion-model-viewport">
      <canvas data-conversion-canvas aria-hidden="true"></canvas>
      <img src={modelImageUrl} alt="" loading="lazy" width="1100" height="800" />
    </div>
  </figure>

  <div class="conversion-input-layer">
    <small>{en ? "COMPONENT DATA" : "元件数据"}</small>
    <strong>LCSC / BOM</strong>
    <span><i></i>{en ? "C2040 · ready" : "C2040 · 已载入"}</span>
  </div>

  <div class="conversion-parts-layer">
    <small>{en ? "LIBRARY PARTS" : "库文件内容"}</small>
    <b>{en ? "SYMBOL" : "符号"}</b>
    <b>{en ? "FOOTPRINT" : "封装"}</b>
    <b>{en ? "3D MODEL" : "3D 模型"}</b>
  </div>

  <div class="conversion-output-layer">
    <small>{en ? "TARGET LIBRARY" : "目标元件库"}</small>
    <strong>{en ? "KiCad / Altium" : "KiCad / Altium"}</strong>
    <span><i>✓</i>{en ? "Ready to use" : "可供设计使用"}</span>
  </div>

  <span class="conversion-scene-note">{en ? "ILLUSTRATIVE MODEL · REAL APP SHOWN BELOW" : "模型为视觉演示 · 实际软件界面见下方"}</span>
</div>
