---
interface Props {
  lang: "zh-CN" | "en";
  alternateUrl: URL;
  variant?: "home" | "inner";
  pageUrl?: URL;
  homeHref?: string;
}

const { lang, alternateUrl, variant = "inner", pageUrl, homeHref: providedHomeHref } = Astro.props;
const en = lang === "en";
const isHome = variant === "home";
const siteRoot = new URL(import.meta.env.SITE);
const siteBase = new URL(import.meta.env.BASE_URL, siteRoot);
const homeHref = providedHomeHref ?? siteBase.href;
const formatsUrl = new URL(en ? "en/formats/" : "formats/", siteBase);
const casesUrl = new URL(en ? "en/cases/" : "cases/", siteBase);
const labUrl = new URL(en ? "en/lab/" : "lab/", siteBase);
const homeCasesHref = "cases/";
const homeLabHref = "lab/";
const docsUrl = "https://github.com/EasyKiconverter/EasyKiConverter/tree/master/docs";
const repositoryUrl = "https://github.com/EasyKiconverter/EasyKiConverter";
const iconUrl = new URL("assets/icons/easyki-icon.svg", siteBase);
const isLab = pageUrl?.pathname.includes("/lab/") ?? false;
const isCurrent = (href: URL) => pageUrl?.pathname === href.pathname;
const headerClass = {
  "content-page-header": !isHome,
  "lab-header": !isHome && isLab,
};
---

<header class:list={["site-header", "shell", headerClass]}>
  <a class="brand" href={homeHref} aria-label={en ? "EasyKiConverter home" : "EasyKiConverter 首页"}>
    <img src={iconUrl.href} alt="" width="36" height="36" />
    <span>EasyKiConverter{!isHome && isLab && <small>{en ? " / Lab" : " / 实验室"}</small>}</span>
  </a>
  <nav class="nav-links" aria-label={isHome ? (en ? "Main navigation" : "主导航") : (en ? "Page navigation" : "页面导航")}>
    {isHome ? <>
      <a href="#story">{en ? "Story" : "体验"}</a>
      <a href="#formats">{en ? "Formats" : "格式矩阵"}</a>
      <a href="#features">{en ? "Features" : "能力"}</a>
      <a href="#workflow">{en ? "Workflow" : "流程"}</a>
      <a href="#download">{en ? "Download" : "下载"}</a>
      <a href={homeLabHref}>{en ? "3D Lab" : "3D 实验室"}</a>
      <a href={homeCasesHref}>{en ? "Cases" : "转换案例"}</a>
      <a class="nav-link-external" href={docsUrl} target="_blank" rel="noreferrer">{en ? "Docs" : "文档"} <span aria-hidden="true">↗</span></a>
    </> : <>
      <a href={homeHref}>{en ? "Home" : "首页"}</a>
      <a href={formatsUrl} aria-current={isCurrent(formatsUrl) ? "page" : undefined}>{en ? "Formats" : "格式矩阵"}</a>
      <a href={casesUrl} aria-current={isCurrent(casesUrl) ? "page" : undefined}>{en ? "Cases" : "转换案例"}</a>
      <a href={labUrl} aria-current={isCurrent(labUrl) ? "page" : undefined}>{en ? "3D Lab" : "3D 实验室"}</a>
      <a href={alternateUrl}>{en ? "中文" : "English"}</a>
    </>}
  </nav>
  <div class="header-actions">
    {isHome && <a class="lang-link" href={alternateUrl}>{en ? "中文" : "EN"}</a>}
    <a class="github-link" href={repositoryUrl} target="_blank" rel="noreferrer">GitHub <span>↗</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-nav">{en ? "Menu" : "菜单"}</button>
  </div>
</header>
<nav id="mobile-nav" class="mobile-nav" aria-label={isHome ? (en ? "Mobile navigation" : "移动端主导航") : (en ? "Mobile page navigation" : "移动端页面导航")}>
  {isHome ? <>
    <a href="#story">{en ? "Story" : "体验"}</a>
    <a href="#formats">{en ? "Formats" : "格式矩阵"}</a>
    <a href="#features">{en ? "Features" : "能力"}</a>
    <a href="#workflow">{en ? "Workflow" : "流程"}</a>
    <a href="#download">{en ? "Download" : "下载"}</a>
    <a href={homeLabHref}>{en ? "3D Lab" : "3D 实验室"}</a>
    <a href={homeCasesHref}>{en ? "Cases" : "转换案例"}</a>
    <a class="nav-link-external" href={docsUrl} target="_blank" rel="noreferrer">{en ? "Docs" : "文档"} <span aria-hidden="true">↗</span></a>
    <a href={alternateUrl}>{en ? "中文" : "English"}</a>
  </> : <>
    <a href={homeHref}>{en ? "Home" : "首页"}</a>
    <a href={formatsUrl} aria-current={isCurrent(formatsUrl) ? "page" : undefined}>{en ? "Formats" : "格式矩阵"}</a>
    <a href={casesUrl} aria-current={isCurrent(casesUrl) ? "page" : undefined}>{en ? "Cases" : "转换案例"}</a>
    <a href={labUrl} aria-current={isCurrent(labUrl) ? "page" : undefined}>{en ? "3D Lab" : "3D 实验室"}</a>
    <a href={alternateUrl}>{en ? "中文" : "English"}</a>
  </>}
  <a href={repositoryUrl} target="_blank" rel="noreferrer">GitHub ↗</a>
</nav>
