  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3"
  }
}
